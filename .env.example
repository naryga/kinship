DATABASE_URL=postgresql+psycopg://kinship:kinship@localhost:5432/kinship
# Only needed for real embeddings; tests use a fake embedder.
OPENAI_API_KEY=
# Embedder: `openai` (default) or `fake` (deterministic test vectors; never for real data).
KINSHIP_EMBEDDER=
# token:owner_id pairs, comma-separated (v0 auth)
KINSHIP_TOKENS=dev-token:1
